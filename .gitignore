.DS_Store
__pycache__/
*.py[cod]
.venv/

# Local submission-development workspaces and rendered previews.
.submission-workspace/
.codex-tmp/
tmp/
*.inspect.ndjson

# Portal documents are uploaded separately, not through the benchmark repo.
*.pptx
*.pdf
*.docx
report_assets/
build_project_report.py

# Official data and generated artifacts are kept out of Git.
data/train/
data/test/
weights/
outputs/
logs/

# KLA explicitly requires restored blind-test outputs and reported evidence.
!outputs/
outputs/*
!outputs/restored/
!outputs/restored/*.npy
!outputs/experiments/
!outputs/experiments/*.json
!outputs/output_manifest.json

# The compact final evaluator checkpoint is intentionally versioned.
!weights/
weights/*
!weights/final.pt

.tmp/
