.DS_Store
__pycache__/
*.py[cod]
.venv/

# Official data and generated artifacts are kept out of Git.
data/train/
data/test/
weights/
outputs/
logs/

# KLA explicitly requires restored blind-test outputs and reported evidence.
!outputs/
outputs/*
!outputs/restored/
!outputs/restored/*.npy
!outputs/experiments/
!outputs/experiments/*.json
!outputs/output_manifest.json

# The compact final evaluator checkpoint is intentionally versioned.
!weights/
weights/*
!weights/final.pt

.tmp/
